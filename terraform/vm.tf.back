
resource "proxmox_vm_qemu" "cloudinit" {
    name = "k8s-master-1"
    desc = "A test for using terraform and cloudinit"

    # Node name has to be the same name as within the cluster
    # this might not include the FQDN
    target_node = "pve"

    # The destination resource pool for the new VM
   # pool = "pool0"

    # The template name to clone this vm from
    clone = "debian-cloud"

    # Activate QEMU agent for this VM
    agent = 0

    os_type = "cloud-init"
    
    cpu {
        cores = 4
        sockets = 1
        type = "host"
    }
    memory = 4096
    scsihw = "virtio-scsi-single"
  #  bios = "ovmf"
    onboot = true
    serial {
           id   = 0
           type = "socket"
    }

  # Optional: To connect the VM's console to this serial port
     vga {
         type = "serial0" # Refers to the serial port with id 0
     } 

    # Setup the disk
    disks {
        ide {
            ide3 {
                cloudinit {
                    storage = "local-data"
                }
            }
        }
        scsi {
            scsi0 {
                disk {
                    size            = 30
                    cache           = "writeback"
                    storage         = "local-data"
 #                   storage_type    = "LVM-Thin"
                    iothread        = true
                    discard         = true
                }
            }
        }
    }

    # Setup the network interface and assign a vlan tag: 256
    network {
        id = 0
        model = "virtio"
        bridge = "vmbr0"
    #    tag = 256
    }

    # Setup the ip address using cloud-init.
    boot = "order=scsi0"
    # Keep in mind to use the CIDR notation for the ip.
    ipconfig0 = "ip=dhcp"
    ciuser = "sacrede"
    cipassword = "temp" 
    sshkeys = <<EOF
    ssh-rsa  root@ansible-master
    EOF
}
 
